# Canonical public URL for production
NEXT_PUBLIC_SITE_URL=https://zanovetech.vercel.app
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WYXN8GWNEY
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-55VQNQWP

# Blog publishing: server-side only, never expose these in public HTML/JS.
